{
  "microscope_name": "Microscope 1",
  "watch_folder": "C:\\MicroscopeData",
  "recursive": true,
  "check_interval_seconds": 3600,
  "daily_report_interval_hours": 24,
  "state_file": "watcher_state.json",
  "log_file": "microscope_watcher.log",
  "transfer": {
    "enabled": false,
    "destination_folder": "",
    "check_interval_seconds": 1800,
    "stable_for_seconds": 60,
    "max_files_per_check": null,
    "max_untransferred_files": 10000
  },
  "sms": {
    "enabled": false,
    "account_sid": "PASTE_TWILIO_ACCOUNT_SID_HERE",
    "auth_token": "PASTE_TWILIO_AUTH_TOKEN_HERE",
    "auth_token_env": "MICWATCHER_TWILIO_AUTH_TOKEN",
    "from_number": "+15017122661",
    "to_number": "",
    "timeout_seconds": 30
  },
  "email": {
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 587,
    "security": "starttls",
    "username": "your-watcher-account@gmail.com",
    "password": "PASTE_GOOGLE_APP_PASSWORD_HERE",
    "password_env": "MICROSCOPE_WATCHER_SMTP_PASSWORD",
    "from_address": "your-watcher-account@gmail.com",
    "to_addresses": [
      "lab-manager@example.org"
    ],
    "timeout_seconds": 30
  }
}
